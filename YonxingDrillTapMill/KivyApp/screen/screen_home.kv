<ScreenHome>:
    BoxLayout:
        orientation: 'vertical'
        padding: 5
        spacing: 5
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 60
            spacing: 5
            padding: 5
            Button:
                text: "CHẠY"
                size_hint_x: None
                width: 120
                on_press: app.m_run(True)
                on_release: app.m_run(False)
            Button:
                text: "DỪNG"
                size_hint_x: None
                width: 120
                on_press: app.m_stop(True)
                on_release: app.m_stop(False)
            Widget:
            Label:
                text: 'CẤU HÌNH'
                size_hint_x: None
                font_size: 20
                width: 120
                halign: 'left'
                valign: 'center'
                text_size: self.size
            TextInput:
                id: profile_name
                size_hint_x: None
                font_size: 30
                width: 480
                hint_text: '...'
                halign: 'left'
                input_filter: root._file_name_filter
                multiline: False
                text_size: self.size
            Button:
                text: "MỞ"
                size_hint_x: None
                width: 120
                on_press: root._profile_load_select()
            Button:
                text: "LƯU"
                size_hint_x: None
                width: 120
                on_press: root._profile_save()
        BoxLayout:
            orientation: 'horizontal'
            spacing: 5
            padding: 5
            size_hint_y: 1.0
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.5
                spacing: 5
                Button:
                    id: face_4
                    on_press: root._select_face(self)
                Button:
                    id: face_5
                    on_press: root._select_face(self)
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.5
                spacing: 5
                Button:
                    id: face_2
                    on_press: root._select_face(self)
                Button:
                    id: face_3
                    on_press: root._select_face(self)
            BoxLayout:
                orientation: 'vertical'
                size_hint_x: 1.0
                spacing: 5
                Button:
                    id: face_0
                    on_press: root._select_face(self)
                Button:
                    id: face_1
                    on_press: root._select_face(self)
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 60
            spacing: 5
            padding: 5
            Button:
                id: cnc_0
                size_hint_x: None
                width: 90
                on_press: root._download_cnc_select(self)
            Button:
                id: cnc_1
                size_hint_x: None
                width: 90
                on_press: root._download_cnc_select(self)
            Button:
                id: cnc_2
                size_hint_x: None
                width: 90
                on_press: root._download_cnc_select(self)
            Button:
                id: cnc_3
                size_hint_x: None
                width: 90
                on_press: root._download_cnc_select(self)
            Button:
                id: cnc_4
                size_hint_x: None
                width: 90
                on_press: root._download_cnc_select(self)
            Button:
                id: cnc_5
                size_hint_x: None
                width: 90
                on_press: root._download_cnc_select(self)
            ProgressBar:
                id: cnc_bar
                max: 100
                value: 0
                size_hint_x: None
                width: 180
            Label:
                id: cnc_state
                font_size: 25
                bold: True
                text: 'DONE'
                size_hint_x: None
                width: 90
                opacity: 0.0
                height: self.texture_size[1]
            Widget:
            Button:
                text: "LOAD"
                size_hint_x: None
                width: 120
                on_press: root.manager.current = 'load'
            Button:
                text: "IN/OUT"
                size_hint_x: None
                width: 120
                on_press: root.manager.current = 'io'
            Button:
                text: "CÀI ĐẶT"
                size_hint_x: None
                width: 120
                on_press: root.manager.current = 'setting'