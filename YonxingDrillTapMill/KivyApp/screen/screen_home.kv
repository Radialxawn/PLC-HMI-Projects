<ScreenHome>:
    AnchorLayout:
        anchor_x: 'left'
        anchor_y: 'top'
        BoxLayout:
            orientation: 'horizontal'
            size_hint: None, None
            size: 240, 60
            spacing: 5
            padding: 5
            Button:
                text: "CHẠY"
            Button:
                text: "DỪNG"
    AnchorLayout:
        anchor_x: 'right'
        anchor_y: 'bottom'
        BoxLayout:
            orientation: 'horizontal'
            size_hint: None, None
            size: 240, 60
            spacing: 5
            padding: 5
            Button:
                text: "IN/OUT"
                on_press: root.manager.current = 'io'
            Button:
                text: "CÀI ĐẶT"
                on_press: root.manager.current = 'setting'
    AnchorLayout:
        anchor_x: 'left'
        anchor_y: 'bottom'
        BoxLayout:
            orientation: 'horizontal'
            size_hint: None, None
            size: 240, 60
            spacing: 5
            padding: 5
            Button:
                text: "NỐI"
                on_press: app.data.connect()
            Button:
                text: "NGẮT"
                on_press: app.data.disconnect()