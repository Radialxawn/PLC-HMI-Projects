<ScreenSetting>:
    BoxLayout:
        orientation: 'vertical'
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 60
            spacing: 5
            padding: 5
            Button:
                text: "THOÁT"
                size_hint_x: None
                width: 120
                on_press: root.manager.current = 'home'
            Widget:
            Button:
                text: "SO DAO"
                size_hint_x: None
                width: 120
                on_press: root._run_tool_setter(True)
                on_release: root._run_tool_setter(False)
            Widget:
            Button:
                text: "TRỤC"
                size_hint_x: None
                width: 120
                on_press: app.m_show_popup_login('7412369', 'setting_axis')
        BoxLayout:
            orientation: 'horizontal'
            spacing: 5
            padding: 5
            BoxLayout:
                size_hint_x: None
                width: 120
            BoxLayout:
                id: left
                orientation: 'vertical'
            BoxLayout:
                size_hint_x: None
                width: 10
            BoxLayout:
                id: right
                orientation: 'vertical'
            BoxLayout:
                size_hint_x: None
                width: 120
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 60
            spacing: 5
            padding: 5
            Button:
                id: hmi.cfsh.accept
                text: 'LƯU'
                size_hint_x: None
                width: 120
                on_press: app.m_save_accept()
            Button:
                id: hmi.cfsh.decline
                text: 'KHÔNG'
                size_hint_x: None
                width: 120
                on_press: app.m_save_decline()
            Widget:
            Button:
                id: face_0
                size_hint_x: None
                width: 80
                on_press: root._face_select(self)
            Button:
                id: face_1
                size_hint_x: None
                width: 80
                on_press: root._face_select(self)
            Button:
                id: face_2
                size_hint_x: None
                width: 80
                on_press: root._face_select(self)
            Button:
                id: face_3
                size_hint_x: None
                width: 80
                on_press: root._face_select(self)
            Button:
                id: face_4
                size_hint_x: None
                width: 80
                on_press: root._face_select(self)
            Button:
                id: face_5
                size_hint_x: None
                width: 80
                on_press: root._face_select(self)
            Widget:
            Button:
                id: hmi.home
                text: 'HOME'
                size_hint_x: None
                width: 90
                on_press: app.m_home()