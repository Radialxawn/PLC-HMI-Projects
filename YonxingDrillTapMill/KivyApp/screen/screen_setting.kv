<ScreenSetting>:
    AnchorLayout:
        anchor_x: 'left'
        anchor_y: 'top'
        BoxLayout:
            orientation: 'horizontal'
            size_hint: None, None
            size: 120, 60
            spacing: 5
            padding: 5
            Button:
                text: "Back"
                on_press: root.manager.current = 'home'
    AnchorLayout:
        anchor_x: 'right'
        anchor_y: 'top'
        BoxLayout:
            orientation: 'horizontal'
            size_hint: None, None
            size: 120, 60
            spacing: 5
            padding: 5
            Button:
                text: "Advanced"
                on_press: root.manager.current = 'setting_advanced'