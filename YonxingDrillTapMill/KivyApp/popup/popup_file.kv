<PopupFile>:
    size_hint: 0.8, 0.8
    auto_dismiss: False
    BoxLayout:
        orientation: 'vertical'
        FileChooserListView:
            id: chooser
            filter_dirs: False
            on_selection: root._select(*args)
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 60
            spacing: 5
            padding: 5
            Label:
                id: warn
                text: 'WARN'
                halign: 'left'
                color: 1, 0, 0, 1
                text_size: self.size
            Widget:
            Button:
                id: delete
                text: 'XOÁ'
                size_hint_x: None
                width: 90
                on_press: root._delete()
            Button:
                id: ok
                text: 'CHỌN'
                size_hint_x: None
                width: 90
                on_press: root._confirm()
            Button:
                text: 'THOÁT'
                size_hint_x: None
                width: 90
                on_press: root._cancel()